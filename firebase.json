{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|ico|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/coindrop/api/rankgoat-publish",
        "function": "rankgoatPublish",
        "region": "us-central1"
      },
      {
        "source": "/coindrop",
        "destination": "/views/coindrop.html"
      },
      {
        "source": "/coindrop/sitemap.xml",
        "function": "coindropSitemapXml",
        "region": "us-central1"
      },
      {
        "source": "/coindrop/robots.txt",
        "function": "coindropRobotsTxt",
        "region": "us-central1"
      },
      {
        "source": "/coindrop/**",
        "function": "serveCoindropPage",
        "region": "us-central1"
      },
      {
        "source": "/sitemap.xml",
        "function": "sitemapXml",
        "region": "us-central1"
      },
      {
        "source": "/robots.txt",
        "function": "robotsTxt",
        "region": "us-central1"
      }
    ],
    "cleanUrls": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
