{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/contentengine-publish",
        "function": "contentenginePublish",
        "region": "us-central1"
      },
      {
        "source": "/sitemap.xml",
        "function": "publishedSitemapXml",
        "region": "us-central1"
      },
      {
        "source": "/robots.txt",
        "function": "publishedRobotsTxt",
        "region": "us-central1"
      },
      {
        "source": "/**",
        "function": "servePublishedPage",
        "region": "us-central1"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|ico|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "cleanUrls": true
  },
  "functions": {
    "source": "functions"
  }
}
