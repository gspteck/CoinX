{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "target": "main",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "sitemap.xml"
      ],
      "headers": [
        {
          "source": "/ads.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|ico|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        },
        {
          "source": "/assets/opt/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/fonts/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(html|xml|txt)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "/robots.txt",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            },
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            }
          ]
        },
        {
          "source": "/sitemap.xml",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=60, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/coindrop",
          "destination": "/views/coindrop.html"
        },
        {
          "source": "/swappr",
          "destination": "/views/swappr.html"
        },
        {
          "source": "/api/contentengine-publish",
          "function": "contentenginePublish",
          "region": "us-central1"
        },
        {
          "source": "/sitemap.xml",
          "function": "publishedSitemapXml",
          "region": "us-central1"
        },
        {
          "source": "/**",
          "function": "servePublishedPage",
          "region": "us-central1"
        }
      ],
      "cleanUrls": true
    },
    {
      "target": "coindrop",
